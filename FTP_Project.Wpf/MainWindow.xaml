<Window x:Class="FTP_Project.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FTP 客户端" Height="600" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="HostInput" Width="150" Margin="0,0,5,0" Text="127.0.0.1"/>
            <TextBox x:Name="PortInput" Width="50" Margin="0,0,5,0" Text="21"/>
            <TextBox x:Name="UsernameInput" Width="100" Margin="0,0,5,0"/>
            <PasswordBox x:Name="PasswordInput" Width="100" Margin="0,0,5,0"/>
            <Button x:Name="ConnectButton" Content="连接" Click="ConnectButton_Click" Margin="0,0,5,0"/>
            <Button x:Name="DisconnectButton" Content="断开" Click="DisconnectButton_Click" IsEnabled="False"/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <Button x:Name="RefreshButton" Content="刷新" Click="RefreshButton_Click" IsEnabled="False" DockPanel.Dock="Left" Margin="0,0,5,0"/>
            <TextBox x:Name="CurrentPath" Text="/"/>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="远程文件">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="RemoteFileList" MouseDoubleClick="RemoteFileList_MouseDoubleClick" FontFamily="Consolas"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                        <Button x:Name="UploadButton" Content="上传" Click="UploadButton_Click" IsEnabled="False" Margin="0,0,5,0"/>
                        <Button x:Name="DownloadButton" Content="下载" Click="DownloadButton_Click" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="日志">
                <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="11"/>
            </GroupBox>
        </Grid>

        <StatusBar Grid.Row="3" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>