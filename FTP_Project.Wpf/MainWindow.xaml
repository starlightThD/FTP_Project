<Window x:Class="FTP_Project.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FTP 客户端" Height="600" Width="850">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 连接面板 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="HostInput" Width="150" Margin="0,0,5,0" Text="127.0.0.1"/>
            <TextBox x:Name="PortInput" Width="50" Margin="0,0,5,0" Text="21"/>
            <TextBox x:Name="UsernameInput" Width="100" Margin="0,0,5,0"/>
            <PasswordBox x:Name="PasswordInput" Width="100" Margin="0,0,5,0"/>
            <Button x:Name="ConnectButton" Content="连接" Click="ConnectButton_Click" Margin="0,0,5,0"/>
            <Button x:Name="DisconnectButton" Content="断开" Click="DisconnectButton_Click" IsEnabled="False"/>
        </StackPanel>

        <!-- 路径导航 -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <Button x:Name="RefreshButton" Content="刷新" Click="RefreshButton_Click" IsEnabled="False" DockPanel.Dock="Left" Margin="0,0,5,0"/>
            <TextBox x:Name="CurrentPath" Text="/"/>
        </DockPanel>

        <!-- 主内容区 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 远程文件 -->
            <GroupBox Grid.Column="0" Header="远程文件">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="RemoteFileList" MouseDoubleClick="RemoteFileList_MouseDoubleClick" FontFamily="Consolas"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                        <Button x:Name="UploadButton" Content="上传" Click="UploadButton_Click" IsEnabled="False" Margin="0,0,5,0"/>
                        <Button x:Name="DownloadButton" Content="下载" Click="DownloadButton_Click" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

            <!-- 传输任务 -->
            <GroupBox Grid.Column="2" Header="传输任务">
                <ListBox x:Name="TransferList">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="LightGray" BorderThickness="1" Padding="8" Margin="0,0,0,5">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DirectionIcon}" Margin="0,0,5,0" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="⏸" Width="28" Height="24" Tag="{Binding Id}" 
                                                    Click="PauseTransfer_Click" Margin="0,0,2,0" FontSize="11"/>
                                            <Button Content="✕" Width="28" Height="24" Tag="{Binding Id}" 
                                                    Click="CancelTransfer_Click" Foreground="Red" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="Gray" Margin="0,3,0,3"/>
                                    <ProgressBar Height="6" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </Grid>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="3" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>